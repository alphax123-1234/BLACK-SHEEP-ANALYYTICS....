# 🐑 BLACK SHEEP Environment Variables
# Copy this to .env and fill in your credentials

# Database Configuration (Neon.tech Free Tier)
DATABASE_URL=postgresql://your_username:your_password@your_host.neon.tech:5432/your_dbname?sslmode=require

# Multi-Platform API Keys (FREE TIERS)
YOUTUBE_API_KEY=your_youtube_api_key_here
TRENDS_API_KEY=your_trends_api_key_here
JUCIER_API_KEY=your_juicer_api_key_here

# Environment
ENVIRONMENT=development
